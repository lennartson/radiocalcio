# Development image: all dependencies, source mounted from the host, auto-restarts on change.
FROM node:22-bookworm-slim
ENV NODE_ENV=development \
    PORT=3000 \
    DB_PATH=/app/data/app.db
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
EXPOSE 3000
# The source itself is bind-mounted by docker-compose.yml, so edits reload immediately.
CMD ["npx", "nodemon", "--legacy-watch", "server.js"]
